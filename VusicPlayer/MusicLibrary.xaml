<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VusicPlayer.MusicLibrary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:media="using:CommunityToolkit.WinUI.Media"
    mc:Ignorable="d">
    <ScrollViewer>
        <Grid Margin="50, 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <TeachingTip Name="ttPlaylistDeleted" Title="Playlist Deleted" IsOpen="False"></TeachingTip>
            <ContentDialog PrimaryButtonClick="dlgConfirmDeletePlaylist_PrimaryButtonClick" Name="dlgConfirmDeletePlaylist" Content="Are you sure you want to delete this playlist?" Title="Delete Playlist" PrimaryButtonText="Delete" DefaultButton="Primary" CloseButtonText="Cancel"></ContentDialog>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button  Grid.Column="0" Name="btnNewPlaylist" Click="btnNewPlaylist_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="20" Source="/Assets/addicon.png"></Image>
                        <TextBlock Margin="5, 0" Text="New Playlist" Style="{StaticResource BodyTextBlockStyle}"></TextBlock>
                    </StackPanel>
                </Button>

                <Border Padding="0" CornerRadius="12" Margin="20, 0" HorizontalAlignment="Left" Grid.Column="1">
                    <Border.Background>
                        <media:BackdropBlurBrush Amount="10.0" />
                    </Border.Background>
                    <Button   BorderThickness="1" BorderBrush="Transparent" HorizontalAlignment="Left" CornerRadius="12"   Margin="0, 0" Name="btnOpenMusic" Click="btnOpenMusic_Click">
                        <Button.Background>
                            <AcrylicBrush TintColor="Transparent" 
TintOpacity="00" 
                   Opacity="0.3"
FallbackColor="Black" 
AlwaysUseFallback="False"/>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">

                            <Image Width="20" Source="/Assets/importicon.png"></Image>
                            <TextBlock Margin="5,0" Text="Open Music" Style="{StaticResource BodyTextBlockStyle}"></TextBlock>
                        </StackPanel>

                    </Button>
                </Border>

            </Grid>
            <StackPanel Margin="0, 20" Orientation="Horizontal" Grid.Row="3">
                <TextBlock Text="Recent Music" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Margin="0, 10"></TextBlock>
                <CheckBox Unchecked="chckmultiplerecent_Unchecked" Name="chckmultiplerecent" Checked="chckmultiplerecent_Checked" Content="Select" Margin="10, 0"></CheckBox>
                <StackPanel Orientation="Horizontal" Visibility="Collapsed"  Name="btnDeleteRecents" Spacing="6">
                    <CheckBox Name="chckSelectAllRecents"  Content="Select all" Checked="chckSelectAllRecents_Checked" Unchecked="chckSelectAllRecents_Unchecked"></CheckBox>
                    <Button Background="Transparent" Name="btnRemoveSelectedRecents" ToolTipService.ToolTip="Remove Selected Recents">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Are you sure you want to remove the selected recents?"></TextBlock>
                                    <Button  Content="Yes remove" Click="Button_Click_1"></Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE74D;"></FontIcon>
                    </Button>
                </StackPanel>

            </StackPanel>
            <StackPanel Name="txtEmptyRecents" Visibility="Collapsed" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/Assets/musicnoteicon.png" Width="30" HorizontalAlignment="Center"></Image>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10" Text="Listen to any music to show them here!" Visibility="Visible" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
            </StackPanel>
            <ContentDialog>
                <Grid VerticalAlignment="Center" Name="AccessDeniedGrid" Visibility="Visible">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <InfoBar Name="ifbMessagee" IsOpen="False"></InfoBar>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/sourceerror.png" HorizontalAlignment="Center" Width="45"></Image>
                            <TextBlock  Text="The file is missing from its path: " Style="{StaticResource BaseTextBlockStyle}" VerticalAlignment="Center" Margin="10, 0"></TextBlock>
                        </StackPanel>
                        <TextBlock Name="txtMissingpath" Text="" Style="{StaticResource BaseTextBlockStyle}" VerticalAlignment="Center" Margin="0, 0"></TextBlock>
                        <Button Name="btnRelocate" Content="Relocate File" ToolTipService.ToolTip="You can select a new location for the file" Click="btnRelocate_Click"></Button>
                        <Button Name="btnRemoveFile" Content="Remove File" ToolTipService.ToolTip="Remove file from Recent Music" Click="btnRemoveFile_Click"></Button>
                    </StackPanel>
                </Grid>
            </ContentDialog>
            <GridView SelectionMode="Single" Name="grdViewRecentMusic" IsItemClickEnabled="True" Grid.Row="4" CanReorderItems="True"  AllowDrop="True" CanDragItems="True"  ItemClick="RecentMusic_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate >
                        <StackPanel Width="150">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Remove from Recents" Click="MenuFlyoutItem_Click_1" Icon="Remove"></MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Go to File Location" Click="MenuFlyoutItem_Click_2" >
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8DA;"></FontIcon>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="View File Info" >
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="D"></FontIcon>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Image Source="{Binding plthumb}" Width="70" Height="70" Stretch="UniformToFill"/>

                            <TextBlock Text="{Binding SongName}" Visibility="Visible" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding FolderName}" Visibility="Visible" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel Margin="0, 20" Orientation="Horizontal" Grid.Row="5" Spacing="10">
                <TextBlock Text="Playlists" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Margin="0, 10"></TextBlock>
                <CheckBox Unchecked="chckmultiple_Unchecked" Name="chckmultiple" Checked="CheckBox_Checked" Content="Select playlist(s)" Margin="10, 0"></CheckBox>
                <StackPanel Orientation="Horizontal" Visibility="Collapsed"   Name="btnDeletePlaylists" Spacing="6">
                    <CheckBox Name="chckSelectAllPlaylists"  Content="Select all" Checked="chckSelectAllPlaylists_Checked" Unchecked="chckSelectAllPlaylists_Unchecked">
                        <CheckBox.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="A"></KeyboardAccelerator>
                        </CheckBox.KeyboardAccelerators>
                    </CheckBox>

                    <Button Background="Transparent" ToolTipService.ToolTip="Delete Selected Playlists">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Are you sure you want to delete the selected playlists?"></TextBlock>
                                    <Button Content="Yes delete" Click="Button_Click"></Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE74D;"></FontIcon>
                    </Button>
                </StackPanel>
                <Button Visibility="Visible" Background="Transparent" Name="btnSortPlaylists" ToolTipService.ToolTip="Sort Playlists">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Sort by name" Tag="name" Click="MenuFlyoutItem_Click_4"></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Sort by items count" Tag="items" Click="MenuFlyoutItem_Click_4"></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Sort by date created" Tag="date" Click="MenuFlyoutItem_Click_4"></MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="d"></FontIcon>
                </Button>
            </StackPanel>
            <StackPanel Name="txtEmptyPlaylists" Visibility="Collapsed" Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/Assets/musicfolder.png" Width="200" HorizontalAlignment="Center"></Image>
                <StackPanel Margin="20, 0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"  Text="You have no playlists created!" Visibility="Visible" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                    <Button Style="{StaticResource AccentButtonStyle}" Margin="0, 20" Name="btnAdd" HorizontalAlignment="Center" Click="btnNewPlaylist_Click" >
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe Fluent Icons" 
Glyph="&#xE710;" 
FontSize="16"
VerticalAlignment="Center"/>

                            <TextBlock Text="New Playlist" 
 Margin="8,0,0,0" 
 VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <GridView CanReorderItems="True"  AllowDrop="True" CanDragItems="True" ItemClick="GrdViewPlaylists_ItemClick"      SelectionMode="Single" IsItemClickEnabled="True" Name="GrdViewPlaylists" Grid.Row="6">
                <GridView.ItemTemplate>
                    <DataTemplate >
                        <StackPanel Width="150">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Name="mnftOpenPlaylist" Text="Open Playlist" Click="mnftOpenPlaylist_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE78B;"></FontIcon>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Delete Playlist" Click="MenuFlyoutItem_Click" Icon="Delete"></MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Image Source="{Binding Thumbnail}" Width="150" Height="100" Stretch="UniformToFill"/>

                            <TextBlock Text="{Binding PlaylistName}" Visibility="Visible" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PlaylistCount}" Visibility="Visible" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PlaylistNowPlaying}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="Visible" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ContentDialog Name="dlgNewPlaylist"  Title="Create a new playlist" PrimaryButtonText="+ Create" DefaultButton="Primary" CloseButtonText="Cancel">

                    <Grid Name="contentsNewPlaylist">
                        <InfoBar Name="mssgBar" IsOpen="False"></InfoBar>
                        <ScrollViewer Name="scrollView">
                            <StackPanel Padding="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">

                                <Grid>
                                    <Button Name="btnReset" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="Transparent">
                                        <Button.Flyout>
                                            <Flyout>
                                                <Button Name="btnActualReset" Content="Reset playlist creation" 
                                    Click="btnActualReset_Click" Style="{StaticResource AccentButtonStyle}"/>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="/Assets/reseticon.png" Width="16" Height="16"/>
                                            <TextBlock Text="Reset Fields" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="12">
                                        <Border CornerRadius="8" Width="200" Height="200" 
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Image Name="imgPlaylistCov" PointerPressed="imgPlaylistCov_PointerPressed" Source="/Assets/playlistdefaultdark.png" Stretch="UniformToFill" />
                                        </Border>
                                        <Button Name="btnAddPlaylistCover" Click="btnAddPlaylistCover_Click" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Source="/Assets/reseticon.png" Width="16"/>
                                                <TextBlock Text="Set Cover Art" />
                                            </StackPanel>
                                        </Button>
                                        <Grid Name="CoverOptions" Visibility="Collapsed" ColumnSpacing="0" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Name="btnEditPlaylistCover" Visibility="Visible" Click="btnAddPlaylistCover_Click" ToolTipService.ToolTip="Change Cover" Grid.Column="0" HorizontalAlignment="Stretch">
                                                <Image Width="14" Source="/Assets/refreshimgicon.png"/>
                                            </Button>
                                            <Button Name="btnRemovePlaylistCover" Margin="10, 0" Click="btnRemovePlaylistCover_Click" ToolTipService.ToolTip="Remove Cover" Grid.Column="1" HorizontalAlignment="Stretch">
                                                <Image Width="14" Source="/Assets/removeicon.png"/>
                                            </Button>

                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                                        <TextBox Name="txtEditPlaylistName" 
                             Header="Playlist Name" 
                             PlaceholderText="Give your playlist a title" 
                             Text="Playlist" 
                             GotFocus="txtEditPlaylistName_GotFocus"/>

                                        <TextBox Name="txtEditGenre" 
                             Header="Genre" 
                             PlaceholderText="e.g. Rock, Lo-Fi, Workout"/>
                                    </StackPanel>

                                </Grid>
                                <Grid>
                                    <TextBlock Name="txtAddedSongs" Text="Added Songs" 
   Style="{StaticResource SubtitleTextBlockStyle}" 
   FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <Button Name="btnAddSongs" Click="btnAddSongs_Click" 
Style="{StaticResource AccentButtonStyle}" 
HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="/Assets/addicon.png" Width="16"/>
                                            <TextBlock Text="Add Songs"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <AutoSuggestBox Name="asbSearchSongs" TextChanged="asbSearchSongs_TextChanged" QuerySubmitted="asbSearchSongs_QuerySubmitted"  QueryIcon="Find" PlaceholderText="Find songs that you added..."></AutoSuggestBox>
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="btnSortItemsInPlaylistDialog">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="/Assets/sorticon.png" Width="16"/>
                                            <TextBlock Text="Sort items"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Name="txtNullAddedSongs" Text="No songs have been added yet!" 
                       Visibility="Visible" FontStyle="Italic" 
                       HorizontalAlignment="Center" Margin="0,40"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>


                                <ListView Name="lstViewPlaylistAddedSongs" 
                      CanDragItems="True" 
                      CanReorderItems="True" 
                      AllowDrop="True"
                      SelectionMode="Single"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="12,8" ColumnSpacing="16" Background="Transparent">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Remove Item" Click="mnftRemoveSongFromPlaylistCreation_Click" Name="mnftRemoveSongFromPlaylistCreation" Icon="Delete"/>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons" 
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Grid.Column="0" VerticalAlignment="Center"/>

                                                <TextBlock ToolTipService.ToolTip="{Binding Title}" Text="{Binding Title}" Grid.Column="1" 
                                       VerticalAlignment="Center" FontWeight="SemiBold" 
                                       TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding FormattedDuration}" Grid.Column="2" 
                                       VerticalAlignment="Center" 
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>


                            </StackPanel>

                        </ScrollViewer>

                    </Grid>
            </ContentDialog>
        </Grid>
    </ScrollViewer>
</Page>

                                                            <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="This property will be applied to all the files selected."></TextBlock>

                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </TabViewItem>
                                            </TabView>
                                        </Grid>
                                    </Grid>
                                </Grid>

                            </ContentDialog>

                            <ScrollView VerticalAlignment="Stretch" Margin="10, 0" Name="ListPanel"  Grid.Row="4">

                                                    <Image Source="/Assets/openfolder.png" Width="20"></Image>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Orientation="Vertical" Spacing="10">
                                                            <TextBlock Text="Confirm removing the selected items from the playlist."></TextBlock>
                                                            <Button Content="Remove" Click="btnRemoveSelections_Click"></Button>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Name="btnEditAlbumMass" ToolTipService.ToolTip="Edit Album property" Margin="0, 10" Click="btnEditAlbumMass_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Assets/openfolder.png" Width="20"></Image>
                                                </StackPanel>
                                            </Button>
                                            <Button Name="btnEditArtistMass" ToolTipService.ToolTip="Edit Artist property" Margin="0, 10" Click="btnEditArtistMass_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Assets/openfolder.png" Width="20"></Image>
                                                </StackPanel>
                                            </Button>
                                            <Button Name="btnAddtoPlaylistMass" ToolTipService.ToolTip="Remove from playlist" Margin="0, 10" Click="btnAddtoPlaylistMass_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Assets/openfolder.png" Width="20"></Image>
                                                </StackPanel>
                                            </Button>

                                            <Button Name="btnSelectAll" ToolTipService.ToolTip="Select All" Margin="0, 10" Click="btnSelectAll_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Assets/openfolder.png" Width="20"></Image>
                                                </StackPanel>
                                            </Button>
                                            <Button Name="btnClearSelection" ToolTipService.ToolTip="Clear Selection" Margin="0, 10" Click="btnClearSelection_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Assets/openfolder.png" Width="20"></Image>
                                                </StackPanel>
                                            </Button>
                                            <Button Name="btnRemoveSelectionsFromFavourites" ToolTipService.ToolTip="Remove Selection from Favourites" Margin="0, 10" Click="btnRemoveSelectionsFromFavourites_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Assets/openfolder.png" Width="20"></Image>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                        <ListView   Margin="0, 0" CanDragItems="True" Visibility="Visible" CanReorderItems="True" AllowDrop="True"
    SelectionMode="Multiple" SelectionChanged="lstViewPlaylist_SelectionChanged" ItemClick="lstViewPlaylist_ItemClick" Name="lstViewPlaylist" >

                                            <ListView.ItemTemplate>

                                                <DataTemplate >
                                                    <Grid Margin="0, 5" VerticalAlignment="Stretch" Background="Transparent" HorizontalAlignment="Stretch">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout Opened="mnftContext_Opened" x:Name="mnftContext" >
                                                                <MenuFlyoutItem IsEnabled="False" Name="txtHeaderContext">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE946;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Play"  Name="mnftPlaySong" Click="mnftPlaySong_Click" Icon="Play"></MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Play Next"  Name="mnftPlaySongNext" Click="mnftPlaySongNext_Click" Icon="Play"></MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Remove" Name="removesongfromplaylistcreation" Click="removesongfromplaylistcreation_Click" Icon="Delete"></MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="File Details"  Name="mnftSongDetails" Click="mnftSongDetails_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE946;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSubItem Text="Add to Playlist"  x:Name="mnftAddtoPlaylist" Loaded="mnftAddtoPlaylist_Loaded">
                                                                    <MenuFlyoutSubItem.Icon>
                                                                        <FontIcon Glyph="&#xECC8;"></FontIcon>
                                                                    </MenuFlyoutSubItem.Icon>
                                                                </MenuFlyoutSubItem>
                                                                <MenuFlyoutItem Text="Add to Play Queue"  Name="mnftAddtoQueue" Click="mnftAddtoQueue_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE81E;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Edit info"  Name="mnftEditInfo" Click="mnftEditInfo_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE70F;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Go to artist"  Name="mnftGoToArtist" Click="mnftGoToArtist_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE77B;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Go to album"  Name="mnftGoToAlbum" Click="mnftGoToAlbum_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE93C;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="{Binding IsFavourite, Converter={StaticResource FavToolTipConverter}}" Tag="Favo"  Name="mnftAddToFavourites" Click="mnftAddToFavourites_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Name="OutlineHeart" 
Glyph="{Binding IsFavourite, Converter={StaticResource FavGlyph}}" 
FontFamily="{StaticResource SymbolThemeFontFamily}" 
Foreground="{Binding IsFavourite, Converter={StaticResource FavColor}}"
                                          FontSize="16"/>
                                                                    </MenuFlyoutItem.Icon>

                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator></MenuFlyoutSeparator>
                                                                <MenuFlyoutItem Text="Move up"  Name="mnftMoveup" Click="mnftMoveup_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE70E;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Move down"  Name="mnftMovedown" Click="mnftMovedown_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE70D;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Move to top"  Name="mnftMovetotop" Click="mnftMovetotop_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74A;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Move to bottom"  Name="mnftMovetobottom" Click="mnftMovetobottom_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74B;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator></MenuFlyoutSeparator>
                                                                <MenuFlyoutItem Visibility="Collapsed" Text="Tools"  Name="mnftTools" Click="mnftTools_Click" >
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE713;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>
                                                        <Button Padding="0" MinHeight="0" MinWidth="0" Margin="0, 0" Width="35" Grid.Column="0" Content="{Binding Glyph}"  FontFamily="Segoe Fluent Icons" Click="Button_Click" Visibility="Visible" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" >
                                                            <Button.Resources>
                                                                <Thickness x:Key="ButtonPadding">0</Thickness>
                                                            </Button.Resources>
                                                        </Button>
                                                        <HyperlinkButton Click="txtTitle_Click" Grid.Column="1" Name="txtTitle"   Visibility="Visible"  Margin="0, 0">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title}"    ToolTipService.ToolTip="{Binding Title}" Foreground="{Binding TitleColor, Mode=OneWay}"></TextBlock>
                                                                <Border Height="2" 
            Background="Cyan" 
            VerticalAlignment="Center" 
            Margin="0,2,0,0"
                                            CornerRadius="4"
            Visibility="{Binding VisibilityOfStrikethrough}" />
                                                            </Grid>
                                                        </HyperlinkButton>
                                                        <HyperlinkButton Grid.Column="2" Name="txtArtistHyp" ToolTipService.ToolTip="{Binding Artist}" Click="txtArtistHyp_Click"   Visibility="Visible"  Margin="0, 0">
                                                            <TextBlock Text="{Binding Artist}"  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                                        </HyperlinkButton>
                                                        <HyperlinkButton ToolTipService.ToolTip="{Binding AlbumName}" Grid.Column="3" Name="txtAlbumHyp" Click="txtAlbumHyp_Click"   Visibility="Visible"  Margin="10, 0">
                                                            <TextBlock Text="{Binding AlbumName}"   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                                        </HyperlinkButton>
                                                        <TextBlock ToolTipService.ToolTip="{Binding FormattedDuration}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="4" Text="{Binding FormattedDuration}" Visibility="Visible" TextWrapping="Wrap" Margin="0, 20"/>
                                                        <Button ToolTipService.ToolTip="{Binding FavString}" Grid.Column="5" Margin="30, 0" x:Name="btnFavourite" 
Click="btnFavourite_Click"
Background="Transparent" 
BorderThickness="0"
                                            DataContextChanged="btnFavourite_DataContextChanged">
                                                            <Grid>
                                                                <FontIcon Name="OutlineHeart2" 
    Glyph="&#xEB51;" 
    FontFamily="{StaticResource SymbolThemeFontFamily}" 
    Foreground="Gray"
                                              FontSize="16"/>

                                                                <FontIcon Name="FillHeart" 
    Glyph="&#xEB52;" Opacity="{Binding FavOpacity, Mode=OneWay}"
    FontFamily="{StaticResource SymbolThemeFontFamily}" 
    Foreground="Red" 
    RenderTransformOrigin="0.5,0.5"  FontSize="16">
                                                                    <FontIcon.RenderTransform>
                                                                        <ScaleTransform ScaleX="{Binding FavOpacity, Mode=OneWay}" 
                        ScaleY="{Binding FavOpacity, Mode=OneWay}"/>
                                                                    </FontIcon.RenderTransform>
                                                                </FontIcon>
                                                            </Grid>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollView>

                            <local:ListViewMedia x:Name="lstViewQueue" Grid.Row="4"></local:ListViewMedia>

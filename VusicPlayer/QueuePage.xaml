<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VusicPlayer.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
       xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TeachingTip Name="ttCreatedInfo" IsOpen="False">
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="Queue saved to Playlist " Name="txtCreatedInfo" Style="{StaticResource BaseTextBlockStyle}"></TextBlock>
                <Button Name="btnViewPlaylist" Click="btnViewPlaylist_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="/Assets/play.png" Width="16"/>
                        <TextBlock Text="View Playlist"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </TeachingTip>
        <ContentDialog Name="dlgNewPlaylist"  Title="Create a new playlist" PrimaryButtonText="+ Create" DefaultButton="Primary" CloseButtonText="Cancel">

            <Grid Name="contentsNewPlaylist">
                <InfoBar Name="mssgBar" IsOpen="False"></InfoBar>
                <ScrollViewer Name="scrollView">
                    <StackPanel Padding="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">

                        <Grid>
                            <Button Name="btnReset" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="Transparent">
                                <Button.Flyout>
                                    <Flyout>
                                        <Button Name="btnActualReset" Content="Reset playlist creation" 
                                    Click="btnActualReset_Click" Style="{StaticResource AccentButtonStyle}"/>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/reseticon.png" Width="16" Height="16"/>
                                    <TextBlock Text="Reset Fields" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="12">
                                <Border CornerRadius="8" Width="200" Height="200" 
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Image Name="imgPlaylistCov" PointerPressed="imgPlaylistCov_PointerPressed" Source="/Assets/playlistdefaultdark.png" Stretch="UniformToFill" />
                                </Border>
                                <Button Name="btnAddPlaylistCover" Click="btnAddPlaylistCover_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="/Assets/reseticon.png" Width="16"/>
                                        <TextBlock Text="Set Cover Art" />
                                    </StackPanel>
                                </Button>
                                <Grid Name="CoverOptions" Visibility="Collapsed" ColumnSpacing="0" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Name="btnEditPlaylistCover" Visibility="Visible" Click="btnAddPlaylistCover_Click" ToolTipService.ToolTip="Change Cover" Grid.Column="0" HorizontalAlignment="Stretch">
                                        <Image Width="14" Source="/Assets/refreshimgicon.png"/>
                                    </Button>
                                    <Button Name="btnRemovePlaylistCover" Margin="10, 0" Click="btnRemovePlaylistCover_Click" ToolTipService.ToolTip="Remove Cover" Grid.Column="1" HorizontalAlignment="Stretch">
                                        <Image Width="14" Source="/Assets/removeicon.png"/>
                                    </Button>

                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                                <TextBox Name="txtEditPlaylistName" 
                             Header="Playlist Name" 
                             PlaceholderText="Give your playlist a title" 
                             Text="Queue" 
                             GotFocus="txtEditPlaylistName_GotFocus"/>

                                <TextBox Name="txtEditGenre" 
                             Header="Genre" 
                             PlaceholderText="e.g. Rock, Lo-Fi, Workout"/>
                            </StackPanel>

                        </Grid>
                        <Grid>
                            <TextBlock Name="txtAddedSongs" Text="Added Songs" 
   Style="{StaticResource SubtitleTextBlockStyle}" 
   FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <Button Name="btnAddSongs" Click="btnAddSongs_Click" 
Style="{StaticResource AccentButtonStyle}" 
HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/addicon.png" Width="16"/>
                                    <TextBlock Text="Add Songs"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <AutoSuggestBox Name="asbSearchSongs" TextChanged="asbSearchSongs_TextChanged" QuerySubmitted="asbSearchSongs_QuerySubmitted"  QueryIcon="Find" PlaceholderText="Find songs that you added..."></AutoSuggestBox>
                        <StackPanel Orientation="Horizontal">
                            <Button Name="btnSortItemsInPlaylistDialog">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/sorticon.png" Width="16"/>
                                    <TextBlock Text="Sort items"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Name="txtNullAddedSongs" Text="No songs have been added yet!" 
                       Visibility="Visible" FontStyle="Italic" 
                       HorizontalAlignment="Center" Margin="0,40"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>


                        <ListView Name="lstViewPlaylistAddedSongs" 
                      CanDragItems="True" 
                      CanReorderItems="True" 
                      AllowDrop="True"
                      SelectionMode="Single"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnSpacing="16" Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Remove Item" Click="mnftRemoveSongFromPlaylistCreation_Click" Name="mnftRemoveSongFromPlaylistCreation" Icon="Delete"/>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons" 
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Grid.Column="0" VerticalAlignment="Center"/>

                                        <TextBlock ToolTipService.ToolTip="{Binding Title}" Text="{Binding Title}" Grid.Column="1" 
                                       VerticalAlignment="Center" FontWeight="SemiBold" 
                                       TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding FormattedDuration}" Grid.Column="2" 
                                       VerticalAlignment="Center" 
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>


                    </StackPanel>

                </ScrollViewer>

            </Grid>
        </ContentDialog>

        <TextBlock Visibility="Collapsed" Text="This page is under construction. It will be available in future updates." Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBlock>
        <InfoBar Name="mssgBarMain" IsOpen="False" Margin="50, 10"></InfoBar>
        <Grid Margin="50, 10">


            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Name="grdNowPlaying">

                <Border x:Name="ShadowTarget" />

                <Grid   CornerRadius="20">
                    <Grid.Background>
                        <ImageBrush ImageSource="/Assets/oceancyan.png" 
                    Stretch="UniformToFill"/>
                    </Grid.Background>
                    <ui:Effects.Shadow>
                        <ui:AttachedDropShadow CastTo="{x:Bind ShadowTarget}" CornerRadius="20" BlurRadius="20" Opacity="0.5" Offset="0,0" />
                    </ui:Effects.Shadow>
                    <Border CornerRadius="20">
                        <Border.Background>
                            <media:BackdropBlurBrush Amount="5.0" />
                        </Border.Background>
                        <ScrollViewer>
                            <StackPanel Margin="30, 15" Padding="15"  CornerRadius="20" Spacing="20" Orientation="Vertical" HorizontalAlignment="Center">
                                <StackPanel.Background>
                                    <AcrylicBrush TintColor="Black" 
                      TintOpacity="0.05" 
                                         Opacity="0.8"
                      FallbackColor="Black" 
                      AlwaysUseFallback="False"/>
                                </StackPanel.Background>
                                <TextBlock HorizontalAlignment="Center" Text="Now Playing" Style="{StaticResource TitleTextBlockStyle}"/>

                                <Grid Name="imgBackground"  CornerRadius="20" Padding="20" Width="300" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                                        <Image Width="110" Name="imgCover" HorizontalAlignment="Center" Source="{x:Bind mediacontroller.Thumbnail2}"/>
                                        <TextBlock Name="txtSongName" Text="{x:Bind mediacontroller.SongDisplayName, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <HyperlinkButton Click="txtArtist_Click" Name="txtArtist" ToolTipService.ToolTip="Artist" HorizontalAlignment="Left" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="• "></TextBlock>
                                                    <TextBlock Name="txtArtistDisplay" Text="{x:Bind mediacontroller.ArtistDisplayName, Mode=OneWay}"></TextBlock>
                                                </StackPanel>
                                            </HyperlinkButton>
                                            <HyperlinkButton Click="txtAlbum_Click" ToolTipService.ToolTip="Album" Name="txtAlbum" Grid.Column="1" HorizontalAlignment="Right" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="• "></TextBlock>
                                                    <TextBlock Name="txtAlbumDisplay" Text="{x:Bind mediacontroller.AlbumDisplayName, Mode=OneWay}"></TextBlock>
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </Grid>

                                        <local:SliderReuse  IsEnabled="True" Value="{x:Bind mediacontroller.CurrentPosition, Mode=TwoWay}" Maximum="{x:Bind mediacontroller.TotalDuration, Mode=TwoWay}" DragStarted="sldMain_DragStarted" DragCompleted="sldMain_DragCompleted"  x:Name="sldMain"/>

                                        <Grid>
                                            <TextBlock Text="{x:Bind mediacontroller.RunningDurationString, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" Name="txtRunningDuration"/>
                                            <TextBlock Text="{x:Bind mediacontroller.TotalDurationString, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Name="txtTotalDuration"/>
                                        </Grid>

                                        <StackPanel Padding="10" Spacing="5" CornerRadius="20" HorizontalAlignment="Center" Orientation="Horizontal">
                                            <StackPanel.Background>
                                                <AcrylicBrush TintColor="Black" 
TintOpacity="0.3" 
           
FallbackColor="Transparent" 
AlwaysUseFallback="False"/>
                                            </StackPanel.Background>
                                            <Button Name="btnPrev" IsEnabled="False"  CornerRadius="10" Background="Transparent" BorderBrush="Transparent" Click="btnPrev_Click">
                                                <Image Name="imgPrev" Width="26" Source="/Assets/previous.png"/>
                                            </Button>
                                            <Button Name="btnPlayPause"  IsEnabled="False"  CornerRadius="10" Background="Transparent" BorderBrush="Transparent" Click="btnPlayPause_Click">
                                                <Image Name="imgPlayPause" Width="26" Source="{x:Bind mediacontroller.Thumbnail}"/>
                                            </Button>
                                            <Button Name="btnNext" IsEnabled="False"  CornerRadius="10" Background="Transparent" BorderBrush="Transparent" Click="btnNext_Click">
                                                <Image Name="imgNext" Width="26" Source="/Assets/next.png"/>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" CornerRadius="20" Padding="10">

                                            <StackPanel.Background>
                                                <AcrylicBrush TintColor="Black" 
TintOpacity="0.3" 
                   
FallbackColor="Black" 
AlwaysUseFallback="False"/>
                                            </StackPanel.Background>
                                            <Button IsEnabled="False"  Background="Transparent" BorderBrush="Transparent" Name="btnVolume" Click="btnVolume_Click">
                                                <FontIcon Name="VolumeIcon" FontSize="15" Glyph="&#xE767;"></FontIcon>
                                            </Button>
                                            <local:SliderReuse IsEnabled="False"  x:Name="sldVolume" Maximum="130" Width="100" Value="100" IsTooltipEnabled="False" ValueChanged="sldVolume_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock FontSize="12" Name="txtVolume" Text="100%" Margin="11, 7"></TextBlock>
                                        </StackPanel>

                                        <StackPanel Spacing="5" HorizontalAlignment="Center" Orientation="Horizontal" Padding="10" CornerRadius="20">
                                            <StackPanel.Background>
                                                <AcrylicBrush TintColor="Black" 
TintOpacity="0.3" 
                   
FallbackColor="Black" 
AlwaysUseFallback="False"/>
                                            </StackPanel.Background>
                                            <Button PointerEntered="btnFav_PointerEntered" PointerExited="btnFav_PointerExited" Name="btnFav" IsEnabled="False"  ToolTipService.ToolTip="Add to Favourites" CornerRadius="10" Background="Transparent" BorderBrush="Transparent">
                                                <Image Name="imgFav" Width="26" Source="/Assets/favicon.png"/>
                                            </Button>
                                            <ToggleButton Name="btnShuffle" ToolTipService.ToolTip="Play Queue Shuffled" Checked="btnShuffle_Checked" Unchecked="btnShuffle_Unchecked"  IsEnabled="False"  CornerRadius="10" Background="Transparent" BorderBrush="Transparent">
                                                <ToggleButton.Resources>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Crimson"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF1746"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#940D28"/>

                                                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#A36C7F"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#FFA9C7"/>
                                                </ToggleButton.Resources>
                                                <Image Name="imgShuffle" Width="26" Source="/Assets/shuffleicon.png"/>
                                            </ToggleButton>
                                            <Button Name="btnOptions" IsEnabled="False"  CornerRadius="10" Background="Transparent" BorderBrush="Transparent">
                                                <Image Name="threedot" Width="26" Source="/Assets/options.png"/>
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Pitch" Name="mnftPitch" Click="mnftPitch_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE946;"></FontIcon>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>

                                    </StackPanel>
                                    <TeachingTip Name="ttPitch" IsOpen="False" Target="{x:Bind btnOptions}">
                                        <StackPanel Margin="5, 0" Orientation="Vertical" Spacing="10">
                                            <TextBlock  Text="Pitch" Style="{StaticResource BaseTextBlockStyle}"></TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <local:SliderReuse Width="200" IsTooltipEnabled="False" x:Name="sldPitch"  Value="1" Maximum="7" Minimum="0.1" ValueChanged="sldPitch_ValueChanged"></local:SliderReuse>
                                                <TextBlock Text="1.0" Margin="0,4" Name="txtPitchValue" ></TextBlock>
                                            </StackPanel>
                                            <Button Content="Reset Pitch" Click="Button_Click_5"></Button>
                                            <ToggleButton Content="Custom" Click="Button_Click_3"></ToggleButton>

                                            <StackPanel Visibility="Collapsed" Orientation="Horizontal" Name="stkPitchCustom" Spacing="5">
                                                <NumberBox Minimum="0.06" Maximum="7" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Inline" Name="nmbPitchCustom" ValueChanged="nmbPitchCustom_ValueChanged"></NumberBox>
                                                <Button Content="Set Pitch" Click="Button_Click_4"></Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </TeachingTip>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">

                <Border x:Name="ShadowTarget2" />
                <Grid 
      Name="grdQueue"
      CornerRadius="20"
      Margin="50,0">
                    <Grid.Background>
                        <AcrylicBrush TintColor="Black" 
TintOpacity="0" 
                   
FallbackColor="Black" 
AlwaysUseFallback="False"/>
                    </Grid.Background>
                    <ui:Effects.Shadow>
                        <ui:AttachedDropShadow CastTo="{x:Bind ShadowTarget2}" CornerRadius="20" BlurRadius="20" Opacity="0.5" Offset="0,0" />
                    </ui:Effects.Shadow>
                    <ScrollViewer>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- HEADER -->
                            <Grid Grid.Row="0" Padding="30,30,30,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Queue"
                   Style="{StaticResource TitleTextBlockStyle}"/>

                                <AutoSuggestBox QuerySubmitted="asbFindQueue_QuerySubmitted"  IsEnabled="False"  Grid.Column="1" Name="asbFindQueue" TextChanged="asbFindQueue_TextChanged"
                        QueryIcon="Find"
                        PlaceholderText="Find in queue..."
                        HorizontalAlignment="Stretch" Height="35" Width="300"/>
                            </Grid>


                            <!-- QUEUE INFO + CONTROLS -->
                            <Grid Grid.Row="1" Padding="30,0,30,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Queue information -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="• 0 items"
                       Name="txtCount"
                       Style="{StaticResource BaseTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <TextBlock Text="• 00:00"
                       Name="txtTotalDurQueue"
                       ToolTipService.ToolTip="Runtime Duration of queue"
                       Style="{StaticResource BaseTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>


                                <!-- Controls -->
                                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10">

                                    <Button IsEnabled="False" Background="Transparent" Name="btnRemoveSelectionFromQueue" Click="btnRemoveSelectionFromQueue_Click"
                    ToolTipService.ToolTip="Remove selection from queue">
                                        <Image Width="20" Source="/Assets/deleteicon.png"/>
                                    </Button>

                                    <ToggleButton Checked="tglShuffleQueue_Checked" Unchecked="tglShuffleQueue_Unchecked" IsEnabled="False"  Background="Transparent" Name="tglShuffleQueue"
                          ToolTipService.ToolTip="Shuffle Play Queue">
                                        <Image Width="20" Source="/Assets/shuffleicon.png"/>
                                    </ToggleButton>

                                    <ToggleButton IsEnabled="False"  Background="Transparent" Name="tglLoopQueue" Checked="tglLoopQueue_Checked" Unchecked="tglLoopQueue_Unchecked"
                          ToolTipService.ToolTip="Loop list">
                                        <Image Width="20" Source="/Assets/StoreLogo.png"/>
                                    </ToggleButton>

                                    <Button  IsEnabled="False"  Background="Transparent" Name="btnClearQueue" Click="btnClearQueue_Click"
                    ToolTipService.ToolTip="Clear Queue">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Image Width="20" Source="/Assets/StoreLogo.png"/>
                                            <TextBlock Text="Clear queue"/>
                                        </StackPanel>
                                    </Button>

                                    <Button  IsEnabled="False"  Background="Transparent" Name="btnSaveQueue" Click="btnSaveQueue_Click"
                    ToolTipService.ToolTip="Save Queue to Playlist">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Image Width="20" Source="/Assets/saveicon.png"/>
                                            <TextBlock Text="Save Queue to Playlist"/>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </Grid>


                            <!-- SECTION LABEL -->
                            <StackPanel Orientation="Horizontal" Grid.Row="2" Spacing="10">
                                <TextBlock 
               Text="Up Next"
               Margin="30,0,0,10"
               FontSize="18" Name="txtUpNext"
               FontWeight="SemiBold"
               Opacity="0.85"/>
                                
                                <ToggleButton Checked="btnViewQueue_Checked" Unchecked="btnViewQueue_Unchecked"  Background="Transparent" Name="btnViewQueue"
>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Image Width="20" Source="/Assets/StoreLogo.png"/>
                                        <TextBlock Text="View full queue"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Button IsEnabled="True" Background="Transparent" Name="btnAddtoQueue" Click="btnOpenMediaFile_Click"
ToolTipService.ToolTip="Add music to queue">
                                    <Image Width="20" Source="/Assets/addicon.png"/>
                                </Button>

                            </StackPanel>


                            <!-- QUEUE LIST -->
                            <ContentDialog  Title="Edit Playlist Info" PrimaryButtonText="Save" DefaultButton="Primary" CloseButtonText="Cancel">

                                <Grid Name="MassEditgrd">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Selected Files" Style="{StaticResource SubtitleTextBlockStyle}" Grid.Row="0"></TextBlock>
                                        <ListView SelectionMode="Multiple" Margin="0, 20" Grid.Row="1" x:Name="lstViewEdit">
                                            <ListView.ItemTemplate>

                                                <DataTemplate >
                                                    <Grid Margin="0, 2" VerticalAlignment="Stretch" Background="Transparent" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                            <ColumnDefinition></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout >
                                                                <MenuFlyoutItem Text="Select item"  Name="mnftSelectitem" Click="mnftSelectitem_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE946;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Unselect item" Name="mnftUnselectItem" Click="mnftUnselectItem_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE946;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Set as album name" Name="mnftSetAlbumName" Click="mnftSetAlbumName_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE946;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Set as artist name" Name="mnftSetArtistName" Click="mnftSetArtistName_Click">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE946;"></FontIcon>
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>
                                                        <Button Padding="0" MinHeight="0" MinWidth="0" Margin="0, 0"  Grid.Column="0" Content="{Binding Glyph}"  FontFamily="Segoe Fluent Icons" Visibility="Visible" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" >
                                                            <Button.Resources>
                                                                <Thickness x:Key="ButtonPadding">0</Thickness>
                                                            </Button.Resources>
                                                        </Button>
                                                        <HyperlinkButton Click="txtTitle_Click" ToolTipService.ToolTip="{Binding Title}" Grid.Column="1"  Visibility="Visible"  Margin="0, 0">
                                                            <TextBlock Text="{Binding Title}" Foreground="{Binding TitleColor, Mode=OneWay}"></TextBlock>
                                                        </HyperlinkButton>
                                                        <HyperlinkButton Grid.Column="2"  ToolTipService.ToolTip="{Binding Artist}" Visibility="Visible"  Margin="0, 0">
                                                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                                        </HyperlinkButton>
                                                        <HyperlinkButton Grid.Column="3" ToolTipService.ToolTip="{Binding AlbumName}"   Visibility="Visible"  Margin="0, 0">
                                                            <TextBlock Text="{Binding AlbumName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                                        </HyperlinkButton>
                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding FormattedDuration}"  Grid.Column="4" Text="{Binding FormattedDuration}" Visibility="Visible" TextWrapping="Wrap" Margin="0, 20"/>

                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="30, 0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Grid.Row="0" Text="Edit Properties"></TextBlock>
                                            <InfoBar x:Name="FileStatusInfoBar" Grid.Row="1"
Title="Action Required"
Message="Checking file status..."
Severity="Warning"
IsOpen="False"
Margin="0,0,0,10">
                                                <InfoBar.ActionButton>
                                                    <Button x:Name="btnFixFile" Content="Fix" Click="btnFixFile_Click" />
                                                </InfoBar.ActionButton>
                                            </InfoBar>
                                            <TabView VerticalAlignment="Stretch" Margin="0, 30" IsAddTabButtonVisible="False"  Grid.Row="2" SelectionChanged="TabView_SelectionChanged">
                                                <TabViewItem  IsClosable="False" Name="tbviArtist" Header="Edit Artist">
                                                    <StackPanel VerticalAlignment="Stretch" Margin="0, 30" Orientation="Vertical" Spacing="20">

                                                        <TextBox Name="txtEditArtist" PlaceholderText="Artist name..."></TextBox>

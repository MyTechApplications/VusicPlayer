                                            <TextBlock x:Name="infoBarMessage" Text="Some files could not be located." Margin="0,0,8,0"/>
                                            <Button Content="Relocate" Click="Button_Click_1"/>
                                        </StackPanel>
                                    </InfoBar>
                                    
                                    <StackPanel Orientation="Vertical" Spacing="10">

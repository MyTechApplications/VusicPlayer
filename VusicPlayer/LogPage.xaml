<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VusicPlayer.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Content="Export Log" Style="{StaticResource AccentButtonStyle}"
                    Click="Button_Click_1"/>
            <Button Content="Refresh Log" Margin="10, 0" Style="{StaticResource AccentButtonStyle}"
            Click="Button_Click_2"/>
        </StackPanel>

        <!-- Tabs -->
        <TabView IsAddTabButtonVisible="False" Name="logTabView" Grid.Row="1">

            <!-- Player Logs -->
            <TabViewItem IsClosable="False" Header="Player Logs" Tag="Player">
                <Grid>
                    <TextBlock Text="No log information available!" Name="txtNoLogs" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, 20" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
                    <StackPanel Name="stackHeader">
                        <!-- Header row -->
                        <Grid Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <!-- Icon -->
                                <ColumnDefinition Width="80"/>
                                <!-- Level -->
                                <ColumnDefinition Width="150"/>
                                <!-- Timestamp -->
                                <ColumnDefinition Width="100"/>
                                <!-- Message -->
                                <ColumnDefinition Width="*"/>
                                <!-- Source -->
                                <ColumnDefinition Width="40"/>
                                <!-- Button -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1" Text="Level" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Margin="10, 0" Text="Timestamp" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="Source" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="Message" FontWeight="Bold"/>
                        </Grid>
                        <ScrollViewer>
                        <ListView Name="lstViewPlayerLogs">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Level}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"  Text="{Binding Timestamp}"
                                           Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Source}"
     />
                                        <TextBlock  IsTextSelectionEnabled="True" Margin="10,0,0,0" Text="{Binding Message}"/>

                                        <Button Background="Transparent" BorderBrush="Transparent" Margin="10,0,0,0"
                                        Click="Button_Click">
                                            <FontIcon Glyph="&#xE8C8;" />
                                            <Button.Flyout>
                                                <Flyout >
                                                    <TextBlock Text="Copied ✔️"></TextBlock>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <!-- Updater Logs -->

        </TabView>
    </Grid>
</Page>

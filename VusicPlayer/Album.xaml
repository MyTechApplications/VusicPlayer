<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VusicPlayer.Album"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="50, 20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MaxWidth="400"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid HorizontalAlignment="Stretch" Grid.Column="0" VerticalAlignment="Stretch" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                <Image Name="imgAlbumCover" Width="300" Height="300" />
            </Viewbox>

            <TeachingTip Title="Finding files across your libraries" Name="ttProgress" >
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Name="prgProgress" IsIndeterminate="True" Width="300" Margin="10, 0"></ProgressBar>
                </StackPanel>
            </TeachingTip>
            <StackPanel Grid.Row="1" Margin="0, 20" Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="Album name" Name="txtAlbumName" 
               Style="{StaticResource TitleTextBlockStyle}" 
               HorizontalAlignment="Center" 
               TextWrapping="Wrap" />
                <StackPanel Margin="0, 20" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="• Album" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="10, 0" Text="• n Items" Name="txtSongCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0, 0" Text="• Artists involved" Name="txtArtistsInvolved" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" 
Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0, 3" />
                    <TextBlock Margin="5, 0" Text="00:00" ToolTipService.ToolTip="Total Runtime of album" 
Name="txtTotalDuration" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <ItemsControl Grid.Row="2" Margin="0, 20" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Button Name="btnRename" Margin="5" ToolTipService.ToolTip="Rename Album" Click="Button_Click">
                    <Button.Flyout>
                        <Flyout x:Name="flyoutRename">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox GotFocus="txtRename_GotFocus" Width="150" Grid.Column="0" 
                             Name="txtRename" PlaceholderText="Rename album" />
                                <Button Background="Transparent" BorderBrush="Transparent" Margin="5, 0" Grid.Column="1" Click="btnRenameAlbum_Click" Name="btnRenameAlbum" >
                                    <Image Margin="5, 0" Width="20" Source="/Assets/tickicon.png" />
                                </Button>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                    <Image Width="25" Source="/Assets/renameicon.png" />
                </Button>

                <Button Name="btnPlayAll" Click="btnPlayAll_Click" Margin="5"
            ToolTipService.ToolTip="Play all songs of Album">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="25" Source="/Assets/play.png" />
                        <TextBlock Margin="5,2" Text="Play all" />
                    </StackPanel>
                </Button>

                <ToggleButton Name="btnShuffle" Click="btnShuffle_Click" Margin="5"
                  ToolTipService.ToolTip="Shuffle playlist">
                    <Image Width="25" Source="/Assets/shuffleicon.png" />
                </ToggleButton>

                <Button Name="btnAddSongs" Click="btnAddSongs_Click" Margin="5"
            ToolTipService.ToolTip="Add songs to this Album">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="25" Source="/Assets/addicon.png" />
                        <TextBlock Margin="5,2" Text="Add Songs" />
                    </StackPanel>
                </Button>
                <Button Name="btnSetAlbumCover" Click="btnSetAlbumCover_Click" Margin="5"
ToolTipService.ToolTip="Set Album Cover">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="25" Source="/Assets/addimgicon.png" />
                        <TextBlock Margin="5,2" Text="Set Album Cover" />
                    </StackPanel>
                </Button>
            </ItemsControl>
            <TeachingTip x:Name="UpdateResultTip"
             Title="Update Complete"
             CloseButtonContent="Got it">
            </TeachingTip>
        </Grid>
        <ScrollView Margin="10, 0" Grid.Column="1">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="No songs in this album!" Style="{StaticResource BodyLargeTextBlockStyle}" Name="txtNoSongs" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0, 20"></TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Album Contents" Name="txtAlbumHeader"></TextBlock>
                    <Button Margin="20, 0" BorderBrush="Transparent" Style="{StaticResource AccentButtonStyle}" Name="btnRefresh" Click="btnRefresh_Click" ToolTipService.ToolTip="Refresh Album">
                        <FontIcon Glyph="&#xE72C;"></FontIcon>
                    </Button>
                </StackPanel>
                <ListView  Margin="0, 10" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
    SelectionMode="Multiple" ItemClick="lstViewPlaylist_ItemClick" Name="lstViewPlaylist" DragItemsCompleted="lstViewPlaylist_DragItemsCompleted">

                    <ListView.ItemTemplate>

                        <DataTemplate >
                            <Grid Margin="0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Play Song" Name="mnftPlaySong" Click="mnftPlaySong_Click" Icon="Play"></MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Remove Song" Name="removesongfromplaylistcreation" Click="removesongfromplaylistcreation_Click" Icon="Delete"></MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Song Details"  Name="mnftSongDetails" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE946;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Add to playlist"  Name="mnftAddtoPlaylist" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xECC8;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Add to play queue"  Name="mnftAddtoQueue" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE81E;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Edit info"  Name="mnftEditInfo" Click="mnftEditInfo_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Go to artist"  Name="mnftGoToArtist" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77B;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Go to album"  Name="mnftGoToAlbum" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE93C;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Add to Favourites"  Name="mnftAddToFavourites" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE735;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator></MenuFlyoutSeparator>
                                        <MenuFlyoutItem Text="Move up"  Name="mnftMoveup" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70E;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Move down"  Name="mnftMovedown" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70D;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Move to top"  Name="mnftMovetotop" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74A;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Move to bottom"  Name="mnftMovetobottom" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74B;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator></MenuFlyoutSeparator>
                                        <MenuFlyoutItem Text="Tools"  Name="mnftTools" Click="mnftSongDetails_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE713;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <TextBlock Margin="0, 12" Grid.Column="0" Text="{Binding Glyph}"  FontFamily="Segoe Fluent Icons" Visibility="Visible" TextWrapping="Wrap" />
                                <HyperlinkButton Grid.Column="1" Name="txtTitle"  Click="txtTitle_Click" Visibility="Visible"  Margin="10, 0">
                                    <TextBlock Text="{Binding Title}" Foreground="{Binding TitleColor, Mode=OneWay}"></TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton Grid.Column="2" Name="txtArtistHyp" Click="txtArtistHyp_Click"   Visibility="Visible"  Margin="0, 0">
                                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                                </HyperlinkButton>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="3" Text="{Binding AlbumName}" Visibility="Visible" TextWrapping="Wrap" Margin="10, 10"/>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="4" Text="{Binding FormattedDuration}" Visibility="Visible" TextWrapping="Wrap" Margin="0, 10"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollView>
    </Grid>

</Page>

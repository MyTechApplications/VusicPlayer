<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VusicPlayer.PlaylistParameters"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Name="contentsNewPlaylist">
        <InfoBar Name="mssgBar" IsOpen="False"></InfoBar>
        <ScrollViewer>
            <StackPanel Padding="24" Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">

                <Grid>


                    <Button Name="btnReset" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="Transparent">
                        <Button.Flyout>
                            <Flyout>
                                <Button Name="btnActualReset" Content="Reset playlist creation" 
                                    Click="btnActualReset_Click" Style="{StaticResource AccentButtonStyle}"/>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="/Assets/reseticon.png" Width="16" Height="16"/>
                            <TextBlock Text="Reset Fields" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <Border CornerRadius="8" Width="200" Height="200" 
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image Name="imgPlaylistCov" Source="/Assets/playlistdefaultdark.png" Stretch="UniformToFill" />
                        </Border>

                        <Button Name="btnAddPlaylistCover" Click="btnAddPlaylistCover_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="/Assets/addicon.png" Width="16"/>
                                <TextBlock Text="Set Cover Art" />
                            </StackPanel>
                        </Button>

                        <Grid Name="CoverOptions" Visibility="Collapsed" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Name="btnEditPlaylistCover" Visibility="Collapsed" Click="btnAddPlaylistCover_Click" ToolTipService.ToolTip="Change Cover" Grid.Column="0" HorizontalAlignment="Stretch">
                                <Image Width="14" Source="/Assets/refreshimgicon.png"/>
                            </Button>
                            <Button Name="btnRemovePlaylistCover" Click="btnRemovePlaylistCover_Click" ToolTipService.ToolTip="Remove Cover" Grid.Column="1" HorizontalAlignment="Stretch">
                                <Image Width="14" Source="/Assets/removeicon.png"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                        <TextBox Name="txtEditPlaylistName" 
                             Header="Playlist Name" 
                             PlaceholderText="Give your playlist a title" 
                             Text="Playlist (1)" 
                             GotFocus="txtEditPlaylistName_GotFocus"/>

                        <TextBox Name="txtEditGenre" 
                             Header="Genre" 
                             PlaceholderText="e.g. Rock, Lo-Fi, Workout"/>
                    </StackPanel>
                </Grid>

                <MenuFlyoutSeparator/>

                <Grid>
                    <TextBlock Name="txtAddedSongs" Text="Added Songs" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <Button Name="btnAddSongs" Click="btnAddSongs_Click" 
                        Style="{StaticResource AccentButtonStyle}" 
                        HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="/Assets/addicon.png" Width="16"/>
                            <TextBlock Text="Add Songs"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <AutoSuggestBox Name="asbSearchSongs" QueryIcon="Find" PlaceholderText="Find songs that you added..."></AutoSuggestBox>
                <StackPanel Orientation="Horizontal">
                    <Button >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="ms-appx:///Assets/addicon.png" Width="16"/>
                            <TextBlock Text="Sort items"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Name="txtNullAddedSongs" Text="No songs have been added yet!" 
                       Visibility="Visible" FontStyle="Italic" 
                       HorizontalAlignment="Center" Margin="0,40"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
               

                <ListView Name="lstViewPlaylistAddedSongs" 
                      CanDragItems="True" 
                      CanReorderItems="True" 
                      AllowDrop="True"
                      SelectionMode="Single"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="16" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Remove Song" Click="MenuFlyoutItem_Click" Icon="Delete"/>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons" 
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Grid.Column="0" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Title}" Grid.Column="1" 
                                       VerticalAlignment="Center" FontWeight="SemiBold" 
                                       TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding FormattedDuration}" Grid.Column="2" 
                                       VerticalAlignment="Center" 
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
               
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VusicPlayer.Playlist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="GlassyDialogStyle" TargetType="ContentDialog">
            <Setter Property="Background">
                <Setter.Value>
                    <AcrylicBrush 
                TintOpacity="0.5" 
                TintLuminosityOpacity="0.5"
                TintColor="{ThemeResource SystemAltHighColor}" 
                FallbackColor="{ThemeResource SystemAltHighColor}" />
                </Setter.Value>
            </Setter>

            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Page.Resources>
    <Grid Margin="50, 20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MaxWidth="400"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <ContentDialog  PrimaryButtonClick="dlgEditProperties_PrimaryButtonClick" PrimaryButtonText="Save" CloseButtonText="Cancel" DefaultButton="Primary" Title="Edit Song Properties" Name="dlgEditProperties">
            <ScrollView Background="Transparent">
                
                <StackPanel Orientation="Vertical" Background="Transparent">
                    <InfoBar x:Name="FileStatusInfoBar"
         Title="Action Required"
         Message="Checking file status..."
         Severity="Warning"
         IsOpen="False"
         Margin="0,0,0,10">
                        <InfoBar.ActionButton>
                            <Button x:Name="btnFixFile" Content="Fix" Click="btnFixFile_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock Text="Song Name"></TextBlock>
                        <TextBox Margin="10, 0" PlaceholderText="Song name...." Name="txtSongName"></TextBox>
                    </StackPanel>
                    <StackPanel Margin="0, 10" Orientation="Horizontal">
                        <TextBlock Text="Song Artist"></TextBlock>
                        <TextBox Margin="10, 0" PlaceholderText="Artist name...." Name="txtArtistName"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Song Album"></TextBlock>
                        <TextBox Margin="10, 0" PlaceholderText="Album name...." Name="txtAlbumName"></TextBox>
                    </StackPanel>
                    <StackPanel Margin="0, 10" Orientation="Horizontal">
                        <TextBlock Text="Contributing Artist"></TextBlock>
                        <TextBox Margin="10, 0" PlaceholderText="Contributing Artist...." Name="txtContributingArtist"></TextBox>
                    </StackPanel>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="Track Number"></TextBlock>
                        <TextBox Margin="10, 0" InputScope="Number" PlaceholderText="Track number...." Name="txtTrack"></TextBox>
                    </StackPanel>
                    <StackPanel Margin="0, 10" Orientation="Horizontal">
                        <TextBlock Text="Genre"></TextBlock>
                        <TextBox Margin="10, 0" PlaceholderText="Genre...." Name="txtGenre"></TextBox>
                    </StackPanel>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Text="Year"></TextBlock>
                        <TextBox InputScope="Number" MaxLength="4" Margin="10, 0" PlaceholderText="Year...." Name="txtYear"></TextBox>
                    </StackPanel>
                    <Button Name="btnOpenFileLoc" Margin="0, 10" Click="btnOpenFileLoc_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/openfolder.png" Width="25"></Image>
                            <TextBlock Margin="5, 0" Text="Go to File Location"></TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollView>
        </ContentDialog>
        <ContentDialog Name="dlgEditPlaylist" PrimaryButtonClick="dlgEditPlaylist_PrimaryButtonClick" Title="Edit Playlist Info" PrimaryButtonText="Save" DefaultButton="Primary" CloseButtonText="Cancel">
            <Grid Name="contentsNewPlaylist">
                <local:PlaylistParameters x:Name="PlaylistDialog"></local:PlaylistParameters>
            </Grid>

        </ContentDialog>
        <Grid HorizontalAlignment="Stretch" Grid.Column="0" VerticalAlignment="Stretch" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
                <Border CornerRadius="100" BorderThickness="0" BorderBrush="White" Opacity="0.9">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Image x:Name="imgPlaylistCover" Source="/Assets/appicon.png"  Stretch="UniformToFill"/>
                </Border>
            </Viewbox>

            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="Playlist name" Name="txtPlaylistName" 
                   Style="{StaticResource TitleTextBlockStyle}" 
                   HorizontalAlignment="Center" 
                   TextWrapping="Wrap" />

                <TextBlock Text="Playlist Genre" Margin="0, 5" Name="txtGenreCov" 
                   Style="{StaticResource SubtitleTextBlockStyle}" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                   HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="• Playlist" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="&#xEC92;" FontFamily="Segoe Fluent Icons" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="25, 3" />
                    <TextBlock Margin="-20, 0" Text="7 October 2008" ToolTipService.ToolTip="Created on" 
                       Name="txtDateCreation" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                 
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 5">
            
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="n items" Margin="0, 2" Name="txtItemCount" 
                   Style="{StaticResource CaptionTextBlockStyle}" 
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                   HorizontalAlignment="Center" />
                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" 
Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="25, 3" />
                    <TextBlock Margin="-22, 0" Text="00:00" ToolTipService.ToolTip="Total Runtime of playlist" 
Name="txtTotalDuration" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <ItemsControl Grid.Row="2" Margin="0, 20" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Button Margin="5" ToolTipService.ToolTip="Rename Playlist" Click="Button_Click_1">
                    <Button.Flyout>
                        <Flyout x:Name="flyoutRename">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox GotFocus="txtRename_GotFocus" Width="150" Grid.Column="0" 
                                 Name="txtRename" PlaceholderText="Rename playlist" />
                                <Button Grid.Column="1" Click="Button_Click">
                                    <Image Margin="5, 0" Width="20" Source="/Assets/tickicon.png" />
                                </Button>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                    <Image Width="25" Source="/Assets/editicon.png" />
                </Button>

                <Button Name="btnPlayAll" Click="btnPlayAll_Click" Margin="5"
                ToolTipService.ToolTip="Play all songs in Playlist">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="25" Source="/Assets/play.png" />
                        <TextBlock Margin="5,2" Text="Play all" />
                    </StackPanel>
                </Button>

                <ToggleButton Name="btnShuffle" Click="btnShuffle_Click" Margin="5"
                      ToolTipService.ToolTip="Shuffle playlist">
                    <Image Width="25" Source="/Assets/shuffleicon.png" />
                </ToggleButton>

                <Button Name="btnAddSongs2" Margin="5"
                ToolTipService.ToolTip="Add songs to this playlist" Click="btnAddSongs_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="25" Source="/Assets/addicon.png" />
                        <TextBlock Margin="5,2" Text="Add Songs" />
                    </StackPanel>
                </Button>
                <Button Name="btnDeletePlaylist" Click="btnDeletePlaylist_Click" Margin="5" ToolTipService.ToolTip="Delete Playlist">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="25" Source="/Assets/deleteicon.png" />
                        <TextBlock Margin="5,2 " Text="Delete playlist" />
                    </StackPanel>
                </Button>
            </ItemsControl>
            <ContentDialog Title="Are you sure you want to delete this playlist?" Content="This cannot be undone!" Name="dlgDeleteConfirmPlaylist" PrimaryButtonText="Delete" DefaultButton="Primary" CloseButtonText="Cancel" PrimaryButtonClick="dlgDeleteConfirmPlaylist_PrimaryButtonClick"></ContentDialog>

            <Button Name="btnEditPlaylistInfo" Grid.Row="3" HorizontalAlignment="Center" Content="Edit Playlist Info" Click="btnEditPlaylistInfo_Click"></Button>
        </Grid>
        <StackPanel Visibility="Collapsed" VerticalAlignment="Center" Orientation="Vertical" Grid.Column="1" Name="panelEmptyplaylists">
            <Image Source="/Assets/openfolder.png" Width="100"></Image>
            <TextBlock Margin="0, 40" HorizontalAlignment="Center" Name="txtEmptyPlaylist" Text="You have no songs in this playlist" VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
            <Button Name="btnAdd" HorizontalAlignment="Center" Click="btnAddSongs_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontFamily="Segoe Fluent Icons" 
                  Glyph="&#xE710;" 
                  FontSize="16"
                  VerticalAlignment="Center"/>

                    <TextBlock Text="Add Songs" 
                   Margin="8,0,0,0" 
                   VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollView VerticalAlignment="Stretch" Margin="10, 0" Name="ListPanel" Grid.Column="1">
            <StackPanel  Orientation="Vertical">

                <InfoBar IsOpen="False" Severity="Warning" Name="iBMissingFiles" Title="Missing files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="infoBarMessage" Text="Some files could not be located." Margin="0,0,8,0"/>
                        <Button Content="Relocate" Click="RelocateButton_Click"/>
                    </StackPanel>
                </InfoBar>
                <StackPanel Orientation="Horizontal" Margin="0, 20">
                    <TextBlock Name="txtPlaylistContentHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Playlist content"></TextBlock>
                    <TextBlock Margin="10,5" Style="{StaticResource BaseTextBlockStyle}" ToolTipService.ToolTip="Playlist will play shuffled" Text="shuffled" Name="txtShuffled" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                </StackPanel>
                <local:ListViewMedia x:Name="lstViewMaster"></local:ListViewMedia>
            </StackPanel>
        </ScrollView>
        <TeachingTip Name="ttInfo" IsOpen="False" PreferredPlacement="Bottom"></TeachingTip>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VusicPlayer.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"    
   xmlns:media="using:CommunityToolkit.WinUI.Media"
xmlns:ui="using:CommunityToolkit.WinUI"
    Title="HomeWindow">


    <Grid Name="grdMaster">
        
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/oceanglow.png" 
Stretch="UniformToFill"/>
        </Grid.Background>
        
        <Border CornerRadius="20">
            <Border.Background>
                <media:BackdropBlurBrush Amount="10.0" />
            </Border.Background>
            <Grid>

                <Frame VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Name="Mainframe"  Visibility="Visible">
                 
                </Frame>
                <Frame Name="frmNavigate" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"></Frame>
            </Grid>
        </Border>
    </Grid>
</Window>

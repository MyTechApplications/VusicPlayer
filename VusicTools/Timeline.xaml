<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VusicTools.Timeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VusicTools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"   AllowDrop="True"
  >



    <Grid Name="grdRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button Name="btnAddVidTr" Click="btnAddVidTr_Click" Content="Add Video Track"></Button>
            <Button Name="btnAddAudTr" Click="btnAddAudTr_Click" Content="Add Audio Track" Margin="10, 0"></Button>
            <Button Name="btnZoomIn" Click="btnZoomIn_Click" Content="+" Margin="0, 0"></Button>
            <Button Name="btnZoomOut" Click="btnZoomOut_Click" Content="-" Margin="10, 0"></Button>
        </StackPanel>
        <Canvas Grid.Row="1" Margin="0, 10"  Height="30" x:Name="canvRuler" Background="#1A1A1A">
        </Canvas>
        <ScrollViewer Margin="0, 0" Grid.Row="2" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel x:Name="VideoHeaderGroup" />
                    <Border Height="20" Background="#111" />
                    <StackPanel x:Name="AudioHeaderGroup" />
                </StackPanel>

                <Canvas x:Name="canvTimeline" Grid.Column="1" 
                    Background="#2B2B2B" Width="5000" Height="500">
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
